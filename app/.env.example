# ── Provider ────────────────────────────────────────────────────
# anthropic (default) | openai
# "openai" also covers any OpenAI-compatible endpoint: vLLM, Ollama,
# OpenRouter, LiteLLM, DeepSeek, Moonshot, …
LLM_PROVIDER=anthropic

# Credential. Provider-native names still work as fallbacks:
#   anthropic → ANTHROPIC_API_KEY or ANTHROPIC_AUTH_TOKEN
#   openai    → OPENAI_API_KEY
LLM_API_KEY=

# Custom endpoint. Overrides the provider default; leave empty for the
# official API. Include the version path your gateway expects, e.g.
#   http://localhost:11434/v1        (Ollama)
#   https://openrouter.ai/api/v1     (OpenRouter)
# Provider-native names also work: ANTHROPIC_BASE_URL / OPENAI_BASE_URL
LLM_BASE_URL=

# ── Model routing ──────────────────────────────────────────────
# Fast model: role-play turns, hints, coach replies, scheduling, scenario generation
# Smart model: post-practice assessment reports
# Defaults are claude-sonnet-5 / claude-opus-5 for anthropic and
# gpt-4.1-mini / gpt-4.1 for openai — set them explicitly for any gateway.
LLM_FAST_MODEL=
LLM_SMART_MODEL=
# The smart model may run on the other protocol: some gateways expose Claude
# only via the native Messages API (/v1/messages) while everything else speaks
# chat completions. Unset → the smart model follows LLM_PROVIDER.
# LLM_SMART_PROVIDER=anthropic
# Endpoint for that provider; defaults to the provider-native var, else
# LLM_BASE_URL with a trailing /v1 stripped. Must NOT end in /v1 for anthropic.
# LLM_SMART_BASE_URL=

# ── Bring-your-own-key ─────────────────────────────────────────
# Learners can always add their own credentials in Settings → 模型; those stay
# in their browser and call the provider directly, never touching this server.
# Set this to force it — a public demo then costs the deployer nothing.
# LLM_REQUIRE_BYOK=true

# ── OpenAI compatibility ───────────────────────────────────────
# Newer OpenAI models require max_completion_tokens; most compatible
# servers only know max_tokens (the default). Switch if your endpoint
# rejects max_tokens.
# LLM_OPENAI_TOKEN_PARAM=max_completion_tokens
# Reasoning-capable OpenAI-compatible models may spend the whole token budget
# on hidden thinking and return no text. How to turn that off differs per
# gateway: `disabled` sends the GLM-style `thinking:{type:"disabled"}`;
# `none` sends DeepSeek-style `reasoning_effort:"none"`. Official OpenAI
# rejects both — leave unset there.
# LLM_OPENAI_THINKING=none

# ── Optional user feedback → Feishu Bitable ─────────────────────
# Server-only credentials. Use a dedicated self-built Feishu application.
# Without all four values, /api/feedback reports unavailable (never fake success).
FEEDBACK_FEISHU_APP_ID=
FEEDBACK_FEISHU_APP_SECRET=
FEEDBACK_FEISHU_BASE_TOKEN=
FEEDBACK_FEISHU_TABLE_ID=
# Set ModelScope / Vercel / Self-hosted for the receiving table.
FEEDBACK_DEPLOYMENT=
FEEDBACK_VERSION=

# ── Optional anonymous usage analytics → the same Feishu Base ──────
# Reuses the FEEDBACK_FEISHU_* app and Base above. Set ONE of the two:
#   prefix → one table per month, <prefix>_YYYY_MM, created by the server
#            when missing (needs the bitable:app scope)
#   id     → a single pinned table; Base tables hold 20,000 rows, so watch it
# Without either, /api/track reports unavailable and the client never sends.
ANALYTICS_FEISHU_TABLE_PREFIX=
ANALYTICS_FEISHU_TABLE_ID=
# Test hook only: point the Feishu client at a mock server.
# FEISHU_BASE_URL=http://127.0.0.1:3200/open-apis
